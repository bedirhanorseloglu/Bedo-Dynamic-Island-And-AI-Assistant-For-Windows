{
  "name": "bedo",
  "productName": "Bedo",
  "version": "1.0.6",
  "author": "Bedirhan Orseloglu",
  "description": "Bedo - The Dynamic Island & AI Assistant for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "dev": "node start-dev.cjs",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && node scripts/prepare-release.cjs && electron-builder --win",
    "release": "node scripts/publish-release.cjs"
  },
  "build": {
    "appId": "com.bedo.assistant",
    "productName": "Bedo",
    "publish": [
      {
        "provider": "github",
        "owner": "bedirhanorseloglu",
        "repo": "Bedo-Dynamic-Island-And-AI-Assistant-For-Windows",
        "releaseType": "draft"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "electron/*.ps1",
      "electron/*.psm1"
    ],
    "files": [
      "dist/**/*",
      {
        "from": "build/release-stage/electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      },
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/release-stage/bedo-runtime",
        "to": "bedo-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Bedo-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bedo",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.16.0",
    "motion": "^14.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.2.0"
  }
}
