{
  "name": "bedo",
  "productName": "Bedo",
  "version": "1.0.3",
  "author": "Bedirhan Orseloglu",
  "description": "Bedo - The Dynamic Island & AI Assistant for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "dev": "node start-dev.cjs",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && node scripts/prepare-release.cjs && electron-builder --win"
  },
  "build": {
    "appId": "com.bedo.assistant",
    "productName": "Bedo",
    "asar": true,
    "asarUnpack": [
      "electron/*.ps1",
      "electron/*.psm1"
    ],
    "files": [
      "dist/**/*",
      {
        "from": "build/release-stage/electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      },
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/release-stage/bedo-runtime",
        "to": "bedo-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "squirrel",
        "zip"
      ]
    },
    "squirrelWindows": {
      "iconUrl": "https://raw.githubusercontent.com/bedirhanorseloglu/Bedo-Dynamic-Island-And-AI-Assistant-For-Windows/main/build/icon.ico",
      "loadingGif": "build/installer-loading.gif",
      "msi": false
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "motion": "^14.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.2.0"
  }
}
